{
  "manifest_version": 3,
  "name": "Chat Context Exporter",
  "version": "1.0.26",
  "description": "Экспортирует ChatGPT в Markdown: строгая полнота, безопасная сериализация noncanonical turn-slot, работа без TOC и диагностический лог.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "downloads",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Экспортировать контекст чата",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
